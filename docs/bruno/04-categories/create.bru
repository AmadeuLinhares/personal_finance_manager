meta {
  name: Create category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bike maintenance",
    "kind": "expense",
    "parentId": "cat_transport",
    "monthlyBudget": 8000,
    "color": "#16a34a"
  }
}

vars:post-response {
  createdCategoryId: res.body.data.id
}

assert {
  res.status: eq 201
}

docs {
  `kind` is `expense` or `income`. Pointing `parentId` at a category that is
  already a child is a `422 VALIDATION_ERROR` with code `too_deep`.
}
