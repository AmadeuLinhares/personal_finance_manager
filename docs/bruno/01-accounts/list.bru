meta {
  name: List accounts (with balances)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/accounts?asOf={{today}}&includeBalances=true
  body: none
  auth: inherit
}

params:query {
  asOf: {{today}}
  includeBalances: true
  ~includeArchived: false
  ~type: checking
  ~currency: CAD
}

vars:post-response {
  accountId: res.body.data[0].id
}

assert {
  res.status: eq 200
  res.body.meta.totalsByCurrency.CAD.currency: eq CAD
}

docs {
  Balances come attached by default — "show the balance of each account" is the
  common case and fanning out N requests for it would be worse. `meta.totalsByCurrency`
  groups totals per currency and never sums across them (no exchange rates here).
  
  Sets the `accountId` runtime var for the rest of the folder.
}
