meta {
  name: Failing report (500)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/reports/monthly-expenses?__error=500
  body: none
  auth: inherit
}

params:query {
  __error: 500
}

assert {
  res.status: eq 500
}

docs {
  Forces one request to fail with `SIMULATED_ERROR`. Header form:
  `x-simulate-error: 503`.
}
