{
  "name": "@pfm/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens for the Classical system: one source of truth, as a Tailwind v4 theme and as typed values.",
  "exports": {
    ".": "./index.ts",
    "./theme.css": "./theme.css"
  },
  "files": [
    "index.ts",
    "theme.css"
  ],
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@pfm/eslint-config": "workspace:*",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  }
}
