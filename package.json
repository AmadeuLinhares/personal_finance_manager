{
  "name": "personal-finance-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @pfm/backend dev",
    "dev:web": "pnpm --filter @pfm/frontend dev",
    "start:api": "pnpm --filter @pfm/backend start",
    "build": "pnpm --filter @pfm/frontend build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"*.{js,mjs,json,md}\" \"packages/eslint/**/*.{js,mjs,json,md}\" && pnpm -r format",
    "format:check": "prettier --check \"*.{js,mjs,json,md}\" \"packages/eslint/**/*.{js,mjs,json,md}\" && pnpm -r format:check",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "reset": "curl -s -X POST http://localhost:4000/api/dev/reset -H 'Content-Type: application/json' -d '{}'",
    "prepare": "husky",
    "knip": "pnpm -r knip",
    "storybook": "pnpm --filter @pfm/ui storybook",
    "build-storybook": "pnpm --filter @pfm/ui build-storybook"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@pfm/eslint-config": "workspace:*",
    "commitlint": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
